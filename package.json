{
  "name": "vibrant-academy-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n retrieval,web -c magenta,cyan \"npm:dev:retrieval\" \"npm:dev:web\"",
    "dev:web": "next dev -p 3001",
    "dev:retrieval": ".venv\\Scripts\\python.exe -m uvicorn backend.app:app --host 127.0.0.1 --port 8765",
    "retrieval:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-retrieval.ps1",
    "retrieval:corpus": ".venv\\Scripts\\python.exe -m backend.build_corpus",
    "retrieval:index": ".venv\\Scripts\\python.exe -m backend.build_index",
    "retrieval:check": ".venv\\Scripts\\python.exe -m backend.eval_retrieval",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.4.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
